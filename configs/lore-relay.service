# systemd unit for the lore relay (Phase A home server / Phase B VPS — same unit).
# Install: copy binary to /usr/local/bin/lore-relay, this file to /etc/systemd/system/,
# create /etc/lore-relay.env from configs/env.example, then:
#   systemctl daemon-reload && systemctl enable --now lore-relay

[Unit]
Description=lore relay — hosted encrypted state
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lore-relay serve
EnvironmentFile=/etc/lore-relay.env
User=lore-relay
DynamicUser=yes
StateDirectory=lore-relay
Environment=LORE_RELAY_DATA=/var/lib/lore-relay
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
