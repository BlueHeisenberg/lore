# lore-relay configuration — copy to .env (or systemd Environment=) and fill in.
# Everything works locally with NO values set: Stripe endpoints stay disabled and
# plans are managed via `lore-relay admin set-plan`.

# --- Core ---
LORE_RELAY_ADDR=:8480              # listen address (behind cloudflared / reverse proxy)
LORE_RELAY_DATA=/var/lib/lore-relay # relay.db + blob storage root
LORE_RELAY_QUOTA_MB=100            # stored bytes per account
LORE_RELAY_TRIAL_DAYS=30           # trial length; after this a trial account is policy-treated as free (0 = never, dev only)

# --- Stripe (Phase 5, account pending) ---
# Test mode first: restricted key from the Stripe dashboard (Developers -> API keys).
STRIPE_SECRET_KEY=                 # sk_test_... (empty = billing disabled, admin-only plans)
STRIPE_WEBHOOK_SECRET=             # whsec_... (Developers -> Webhooks -> endpoint secret)
STRIPE_PRICE_ID=                   # price_... for the relay subscription
# Webhook endpoint to register in Stripe: https://<relay-domain>/v1/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted

# --- Client side (lore CLI on each device) ---
# LORE_RELAY_URL=https://relay.<domain>   # set in ~/.lore/config.json instead: {"relay_url": "..."}
